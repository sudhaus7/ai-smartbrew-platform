{
	"name": "symfony/ai-smartbrew-platform",
	"description": "smartbrew.ai platform bridge for Symfony AI",
	"license": "MIT",
	"type": "symfony-ai-platform",
	"keywords": [
		"ai",
		"bridge",
		"local",
		"smartbrew",
		"platform"
	],
	"authors": [
		{
			"name": "Frank Berger",
			"email": "fberger@sudhaus7.de"
		}
	],
	"require": {
		"php": ">=8.2",
		"symfony/ai-platform": "^0.12",
		"symfony/http-client": "^7.3|^8.0"
	},
	"require-dev": {
		"phpstan/phpstan": "^2.1",
		"phpstan/phpstan-phpunit": "^2.0",
		"phpstan/phpstan-strict-rules": "^2.0",
		"phpunit/phpunit": "^11.5.53"
	},
	"minimum-stability": "dev",
	"autoload": {
		"psr-4": {
			"Symfony\\AI\\Platform\\Bridge\\Smartbrew\\": ""
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Symfony\\AI\\PHPStan\\": "../../../../../.phpstan/",
			"Symfony\\AI\\Platform\\Bridge\\Smartbrew\\Tests\\": "Tests/"
		}
	},
	"config": {
		"sort-packages": true
	},
	"extra": {
		"thanks": {
			"name": "symfony/ai",
			"url": "https://github.com/symfony/ai"
		}
	}
}
